# ===== 服务配置 =====
PORT=3000
# 生产环境建议: 4 核机器 workers=4，0 表示自动 (=CPU 核数)
WORKERS=4

# JWT 密钥（部署前必须改成随机长字符串: openssl rand -hex 32）
JWT_SECRET=change-me-to-a-long-random-string
# 登录态有效期（秒），默认 12 小时
SESSION_TTL=43200

# ===== 综测数据配置 =====
# 前 N 名不公布本轮综测排名（总排名进入前 N 的学生，其专业排名和总排名都不显示）
# 设为 0 = 不隐藏，所有人都显示排名
HIDE_TOP_N=30
# 隐藏规则按什么排名判定: total=全校总排名 / major=专业内排名
HIDE_RULE=total
# 轮次名称（页面标签显示）
ROUND_LABEL=第二轮

# ===== CAS 配置 =====
CAS_BASE_URL=https://cas.dlufl.edu.cn
# 本站对外访问地址（生产必填，https 开头、无末尾斜杠）
# CAS 回调地址 = PUBLIC_URL/api/cas/callback，需在学校 CAS 侧登记为允许的 service
PUBLIC_URL=https://zongce.example.edu.cn
# 数据导入用 Excel 路径（仅 npm run import 时使用）
EXCEL_PATH=C:/Users/recode/Desktop/综测总表.xlsx
