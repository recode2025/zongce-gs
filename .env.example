# ===== 服务配置 =====
PORT=3000
# 生产环境建议: 4 核机器 workers=4，0 表示自动 (=CPU 核数)
WORKERS=4

# JWT 密钥（部署前必须改成随机长字符串: openssl rand -hex 32）
JWT_SECRET=change-me-to-a-long-random-string
# 登录态有效期（秒），默认 12 小时
SESSION_TTL=43200

# ===== 综测数据配置 =====
# 轮次名称（页面标签显示）
ROUND_LABEL=第二轮

# ===== CAS 配置 =====
CAS_BASE_URL=https://cas.dlufl.edu.cn
# 数据导入用 Excel 路径（仅 npm run import 时使用）
EXCEL_PATH=C:/Users/recode/Desktop/综测总表.xlsx
